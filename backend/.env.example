# =============================================================================
# SunTax Backend – Environment Variables
# Copy this file to .env and fill in real values. NEVER commit .env to Git.
# =============================================================================

# --- Database ----------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://suntax:changeme@localhost:5432/suntax

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Security ----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_64_CHAR_HEX_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- MinIO / S3-compatible storage -------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=suntax-documents
MINIO_USE_SSL=false

# --- Google Gemini AI --------------------------------------------------------
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# --- Frontend URL (for CORS and email links) ---------------------------------
FRONTEND_URL=http://localhost:3000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# --- Email (Resend) ----------------------------------------------------------
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
EMAIL_FROM=noreply@suntax.ch

# --- Monitoring (optional) ---------------------------------------------------
SENTRY_DSN=

# --- File upload limits ------------------------------------------------------
MAX_UPLOAD_SIZE_MB=50

# --- Environment -------------------------------------------------------------
ENVIRONMENT=development
