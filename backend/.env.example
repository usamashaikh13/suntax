# ─────────────────────────────────────────────────────────────────────────────
# SunTax Backend — Environment Variables
# Copy this file to .env and fill in the values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (default for local development — no setup required)
DATABASE_URL=sqlite+aiosqlite:///./suntax_dev.db
# For production: DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/suntax

# ── Environment ───────────────────────────────────────────────────────────────
# development | production | test
ENVIRONMENT=development

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_a_64_char_random_string_here

# ── Gemini AI ─────────────────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── CORS ──────────────────────────────────────────────────────────────────────
# JSON array of allowed frontend origins
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# ── Redis ─────────────────────────────────────────────────────────────────────
# Optional in development — fakeredis is used automatically when Redis is
# unavailable. Set this for production or when running Celery workers.
REDIS_URL=redis://localhost:6379/0

# ── Object Storage (MinIO / S3) ───────────────────────────────────────────────
# Optional in development — local filesystem storage is used automatically.
# For production, point these at your MinIO instance or AWS S3.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=suntax-documents
MINIO_USE_SSL=false

# ── Email Providers (Resend or Twilio SendGrid) ──────────────────────────────
# Optional in dev — when blank or ENVIRONMENT=development, emails are printed
# to the console. Configure either Resend or Twilio SendGrid for production.
RESEND_API_KEY=
EMAIL_FROM=noreply@suntax.ch
TWILIO_SENDGRID_API_KEY=

# ── Phone Text Messages (Twilio SMS) ─────────────────────────────────────────
# Optional in dev — when blank or ENVIRONMENT=development, SMS messages are
# printed to the console. Configure for 2FA SMS and status notifications.
# Get credentials at: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE_NUMBER=  # E.164 phone number, e.g. +41791234567

# ── Sentry Error Tracking ─────────────────────────────────────────────────────
# Optional — leave blank to disable. Get your DSN at: https://sentry.io
SENTRY_DSN=

# ── Frontend ──────────────────────────────────────────────────────────────────
# Used for email verification / password-reset links
FRONTEND_URL=http://localhost:3000
