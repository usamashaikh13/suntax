# ─────────────────────────────────────────────────────────────
#  SunTax – Environment Variables Template
#  Copy to .env and fill in every value before starting.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://suntax:CHANGE_ME@postgres:5432/suntax
POSTGRES_USER=suntax
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=suntax

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://:CHANGE_REDIS_PASSWORD@redis:6379/0
REDIS_PASSWORD=CHANGE_REDIS_PASSWORD

# ── Security ──────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=GENERATE_A_SECURE_64_CHAR_RANDOM_STRING_HERE
# Access token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Refresh token lifetime in days
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── MinIO / S3 Object Storage ─────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME_THIS_MUST_BE_AT_LEAST_8_CHARS
MINIO_BUCKET_NAME=suntax-documents
MINIO_USE_SSL=false
# For production with external S3, set MINIO_USE_SSL=true

# ── AI / Google Gemini ────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ── Frontend / CORS ───────────────────────────────────────────
FRONTEND_URL=https://your-domain.com
NEXT_PUBLIC_API_URL=https://your-domain.com/api/v1
NEXT_PUBLIC_WS_URL=wss://your-domain.com/ws

# ── Email (Resend) ────────────────────────────────────────────
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=noreply@your-domain.com

# ── Domain (used by Nginx) ────────────────────────────────────
DOMAIN_NAME=your-domain.com

# ── Monitoring (optional) ─────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# ── Environment ───────────────────────────────────────────────
# Values: development | production | staging
ENVIRONMENT=production

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
